generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum EventStatus {
  DRAFT
  WAITING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DatePrecision {
  UNKNOWN
  MONTH
  WEEK
  CANDIDATES
  EXACT
}

enum NotificationType {
  ASSIGNMENT
  REMINDER_H1
  REMINDER_TODAY
  EVENT_UPDATED
}

model User {
  id              String         @id @default(cuid())
  name            String
  username        String         @unique
  password_hash   String
  role            UserRole       @default(USER)
  created_at      DateTime       @default(now())
  events_created  Event[]        @relation("CreatedBy")
  events_updated  Event[]        @relation("UpdatedBy")
  letters_created LetterRecord[] @relation("LetterCreator")
  assigned_duties EventOfficer[] @relation("AssignedOfficer")
  notifications   Notification[] @relation("UserNotifications")

  @@map("users")
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  color          String   // Hex color code, e.g. #2563EB
  icon           String?  // Optional icon name
  document_slots Json?    // Custom document slot rules per category (CategoryDocumentSlot[])
  created_at     DateTime @default(now())
  events         Event[]

  @@map("categories")
}

model Location {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  events     Event[]

  @@map("locations")
}

model Event {
  id                   String               @id @default(cuid())
  name                 String
  category_id          String
  category             Category             @relation(fields: [category_id], references: [id])
  status               EventStatus          @default(DRAFT)
  date_precision       DatePrecision        @default(UNKNOWN)
  estimated_month      String?              // e.g. "2026-10"
  estimated_week_label String?              // e.g. "Minggu ke-2 Oktober 2026"
  event_date           DateTime?            @db.Date
  start_time           String?              // HH:mm format, e.g. "09:00"
  end_time             String?              // HH:mm format, e.g. "12:00"
  is_all_day           Boolean              @default(false)
  location_name        String?              // Free-text manual location (e.g. Ruang Rapat A, Lab 1, dll)
  location_id          String?
  location             Location?            @relation(fields: [location_id], references: [id])
  description          String?              @db.Text
  contact_info         String?              // External school/partner contact
  requirements_notes   String?              @db.Text // Free-text multiline notes for barang/alat/konsumsi
  is_deleted           Boolean              @default(false)
  created_by_id        String
  created_by           User                 @relation("CreatedBy", fields: [created_by_id], references: [id])
  updated_by_id        String?
  updated_by           User?                @relation("UpdatedBy", fields: [updated_by_id], references: [id])
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  candidate_dates      EventCandidateDate[]
  attachments          EventAttachment[]
  officers             EventOfficer[]
  notifications        Notification[]

  @@index([event_date])
  @@index([location_id])
  @@index([category_id])
  @@index([status])
  @@index([location_id, event_date])
  @@map("events")
}

model EventCandidateDate {
  id             String   @id @default(cuid())
  event_id       String
  event          Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  candidate_date DateTime @db.Date
  created_at     DateTime @default(now())

  @@index([event_id])
  @@map("event_candidate_dates")
}

model EventAttachment {
  id                 String   @id @default(cuid())
  event_id           String
  event              Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  file_name          String
  file_size          Int?
  mime_type          String?
  slot_key           String?  // 'MEDIA' | slot.key (e.g. 'daftar_hadir', 'notulensi', 'OTHER')
  slot_label         String?  // Readable snapshot label e.g. 'Scan Daftar Hadir Siswa (PDF)'
  drive_file_id      String?  // Google Drive File ID
  drive_view_url     String   // Link Google Drive preview
  drive_download_url String?  // Link Google Drive download
  created_at         DateTime @default(now())

  @@index([event_id])
  @@index([slot_key])
  @@map("event_attachments")
}

model LetterRecord {
  id            String   @id @default(cuid())
  template_type String   // 'MAGANG', 'TUGAS', 'UNDANGAN', 'AKTIF', 'PERMOHONAN', 'CUSTOM'
  title         String
  reference_no  String?  // Nomor surat
  event_id      String?  // Optional link to event
  created_by_id String
  created_by    User     @relation("LetterCreator", fields: [created_by_id], references: [id])
  payload_json  String   @db.Text // Full letter data / recipient rows
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([created_by_id])
  @@map("letter_records")
}

model EventOfficer {
  id         String   @id @default(cuid())
  event_id   String
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation("AssignedOfficer", fields: [user_id], references: [id], onDelete: Cascade)
  role       String?  // Custom typed role: "Koordinator", "Dokumentasi", "Pemateri", "Perlengkapan", dll.
  notes      String?
  created_at DateTime @default(now())

  @@unique([event_id, user_id])
  @@index([user_id])
  @@index([event_id])
  @@map("event_officers")
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  user       User             @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
  event_id   String?
  event      Event?           @relation(fields: [event_id], references: [id], onDelete: SetNull)
  title      String
  message    String
  type       NotificationType @default(ASSIGNMENT)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  @@index([user_id, is_read])
  @@map("notifications")
}
